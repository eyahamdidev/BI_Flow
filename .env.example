# Copy to .env (the start scripts do it for you). Never commit .env.

# ---- LLM (optional) -------------------------------------------------------------------------------
# Without a key, BIFlow still runs end to end: every LLM step has a no-LLM fallback (template text).
# With a key, the narratives, run summary and explanations are written by the LLM (numbers fact-checked).
# Any OpenAI-compatible provider works. Free option: Groq (https://console.groq.com/keys).
LLM_PROVIDER=api
BIFLOW_PROFILE=api
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Local alternative (free, private, needs ~8-16 GB RAM): install Ollama, `ollama pull qwen2.5:7b-instruct llama3.2:3b`, then
# LLM_PROVIDER=ollama / BIFLOW_PROFILE=ollama / LLM_BASE_URL=http://host.docker.internal:11434/v1 / LLM_API_KEY=ollama

# Embeddings for the KPI search: local = built-in (no download needed); ollama = nomic-embed-text if you run Ollama.
EMBED_PROVIDER=local

# ---- Platform -------------------------------------------------------------------------------------
BIFLOW_MOCK=0                 # 0 = real modules. 1 = canned mock answers (CI / module development only)
FAKE_LLM=0                    # 1 = canned LLM answers from tests/fixtures/llm (CI)
LLM_TIMEOUT_S=30              # per LLM call
LLM_RETRIES=3

# Only if containers cannot reach the internet directly (check: docker info | grep -i proxy).
# HTTPS_PROXY=http://http.docker.internal:3128
# HTTP_PROXY=http://http.docker.internal:3128
