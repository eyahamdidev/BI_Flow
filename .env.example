# Copy to .env (never commit it). Each developer picks ONE LLM option.

# ---- Option A: local with Ollama (free, private, needs RAM) ----
#   1) install Ollama   2) ollama pull qwen2.5:7b-instruct llama3.2:3b nomic-embed-text
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# ---- Option B: any OpenAI-compatible API key (Groq, OpenRouter, OpenAI, Together, ...) ----
# LLM_PROVIDER=api
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=sk-...

# Profile from config/models.yaml: ollama | low_ram | api   (default = LLM_PROVIDER)
# BIFLOW_PROFILE=low_ram
# Per-developer model overrides
# LLM_MODEL_MAIN=
# LLM_MODEL_FAST=

# Embeddings: ollama | local | api   (the KPI index auto-rebuilds if the embedder differs)
EMBED_PROVIDER=ollama
# EMBED_BASE_URL=http://localhost:11434/v1

# ---- Platform ----
BIFLOW_MOCK=1                 # 1 = services return mock/<mode>.json fixtures. Set to 0 per module as you implement it.
FAKE_LLM=0                    # 1 = canned answers from tests/fixtures/llm (CI uses this)
DATA_DIR=./data
BIFLOW_CACHE=.cache/llm.sqlite

# Module URLs used by the gateway (defaults shown; Compose overrides them)
# URL_INGEST_QUALITY=http://localhost:8104
# URL_PROFILE_CLEAN=http://localhost:8103
# URL_ETL=http://localhost:8101
# URL_SEMANTIC_KPI=http://localhost:8105
# URL_ANALYST=http://localhost:8106
# URL_AUDITOR=http://localhost:8102
# GATEWAY_URL=http://localhost:8000
